// Internship Search Tracker — Prisma schema
// SQLite does not support native enums, so status-like fields are Strings
// validated in the application layer (see src/lib/constants.ts) — this also
// lets the user define custom statuses without a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------------

model Country {
  id                 String   @id @default(cuid())
  name               String   @unique
  code               String?  @unique // ISO 3166-1 alpha-2
  region             String?
  personalPreference Int      @default(3) // 1-5, how much the user likes this destination
  visaNotes          String? // personal notes only — NOT legal advice
  costOfLivingNotes  String?
  averageSalaryNote  String?
  usefulLinks        String? // JSON array of {label, url}
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cities        City[]
  companies     Company[]
  applications  Application[]
  contacts      Contact[]
  researchItems ResearchItem[]
  notes         Note[]
  offers        Offer[]

  @@index([name])
}

model City {
  id        String   @id @default(cuid())
  name      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  applications Application[]

  @@unique([name, countryId])
}

// ---------------------------------------------------------------------------
// Companies
// ---------------------------------------------------------------------------

model Company {
  id               String   @id @default(cuid())
  name             String
  logoUrl          String?
  website          String?
  linkedin         String?
  countryId        String?
  country          Country? @relation(fields: [countryId], references: [id])
  citiesText       String? // free text list of hiring cities, e.g. "London, Manchester"
  sector           String?
  type             String? // e.g. Startup, Bank, Consulting, Big Tech...
  size             String? // e.g. "1-10", "11-50", "51-200", "201-1000", "1000+"
  description      String?
  personalNote     String?
  interestLevel    Int      @default(3) // 1-5
  fitScore         Int      @default(0) // 0-100, computed by scoring engine
  wishlistCategory String? // DREAM | HIGH_PRIORITY | TARGET | BACKUP | EXPLORATORY
  wishlistProgress Int      @default(0) // 0-100 manual progress tracker
  isDemo           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications  Application[]
  contacts      Contact[]
  documents     Document[]
  notes         Note[]
  events        Event[]
  tasks         Task[]
  interactions  Interaction[]
  researchItems ResearchItem[]
  interviews    Interview[]
  offers        Offer[]
  coverLetters  CoverLetter[]
  tags          Tag[]          @relation("CompanyTags")

  @@index([name])
}

// ---------------------------------------------------------------------------
// Pipeline / custom statuses
// ---------------------------------------------------------------------------

model PipelineStage {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  isSystem  Boolean  @default(false) // seeded default stage, not deletable from UI
  kind      String   @default("APPLICATION") // APPLICATION | NETWORKING
  createdAt DateTime @default(now())

  applications Application[]
}

// ---------------------------------------------------------------------------
// Applications (the core tracker)
// ---------------------------------------------------------------------------

model Application {
  id        String  @id @default(cuid())
  title     String // intitulé du stage
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])

  remotePossible Boolean @default(false)
  sector         String?
  department     String?

  jobUrl String?
  source String? // LinkedIn, Site entreprise, Candidature spontanée, Networking, ...

  primaryContactId String?
  primaryContact   Contact?  @relation("ApplicationPrimaryContact", fields: [primaryContactId], references: [id])
  contacts         Contact[] @relation("ApplicationContacts")

  discoveredAt       DateTime?
  appliedAt          DateTime?
  deadline           DateTime?
  potentialStartDate DateTime?
  durationMonths     Int?

  salaryAmount        Float?
  salaryCurrency      String?  @default("EUR")
  housingProvided     Boolean?
  visaRequired        Boolean?
  sponsorshipPossible Boolean?
  languageRequired    String?

  priority             String @default("MEDIUM") // LOW | MEDIUM | HIGH | DREAM
  interestScore        Int    @default(50) // 0-100
  estimatedProbability Int    @default(50) // 0-100

  statusId String
  status   PipelineStage @relation(fields: [statusId], references: [id])

  nextAction        String?
  nextActionDate    DateTime?
  followUpCount     Int       @default(0)
  lastInteractionAt DateTime?

  notes              String?
  interviewPrepNotes String? // AI-generated "Prepare interview" output, rattaché directement à l'opportunité
  isDemo             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     Document[]
  tasks         Task[]
  events        Event[]
  interactions  Interaction[]
  interviews    Interview[]
  offer         Offer?
  coverLetter   CoverLetter?
  interviewPrep InterviewPrep?
  notesList     Note[]
  researchItems ResearchItem[]
  tags          Tag[]          @relation("ApplicationTags")
  jobAnalysis   JobAnalysis?

  @@index([companyId])
  @@index([statusId])
  @@index([deadline])
  @@index([nextActionDate])
}

// ---------------------------------------------------------------------------
// Contacts / CRM
// ---------------------------------------------------------------------------

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  position  String?
  email     String?
  phone     String?
  linkedin  String?
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])
  city      String?

  contactType          String @default("OTHER") // RECRUITER | HR | MANAGER | ALUMNI | STUDENT | PROFESSOR | PERSONAL | EMPLOYEE | FOUNDER | SPEAKER | OTHER
  relationshipStrength Int    @default(2) // 1-5

  firstContactDate  DateTime?
  lastInteractionAt DateTime?
  nextFollowUpDate  DateTime?

  networkingStage     String? // IDENTIFIED | TO_CONTACT | CONTACTED | RESPONDED | CALL | ACTIVE_RELATION | REFERRAL
  linkedinRequestSent Boolean @default(false)
  linkedinAccepted    Boolean @default(false)
  referralObtained    Boolean @default(false)

  notes  String?
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryForApplications Application[] @relation("ApplicationPrimaryContact")
  applications           Application[] @relation("ApplicationContacts")
  interactions           Interaction[]
  tasks                  Task[]
  events                 Event[]
  notesList              Note[]
  tags                   Tag[]         @relation("ContactTags")

  @@index([lastName])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Timeline / interactions
// ---------------------------------------------------------------------------

model Interaction {
  id            String       @id @default(cuid())
  type          String // EMAIL | LINKEDIN | CALL | INTERVIEW | MEETING | EVENT | RECOMMENDATION | STATUS_CHANGE | NOTE | OTHER
  date          DateTime     @default(now())
  summary       String
  details       String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([applicationId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  category      String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  priority      String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  dueDate       DateTime?
  status        String       @default("TODO") // TODO | IN_PROGRESS | DONE
  recurrence    String? // NONE | DAILY | WEEKLY | MONTHLY
  completedAt   DateTime?
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

model Event {
  id            String       @id @default(cuid())
  title         String
  type          String // DEADLINE | FOLLOW_UP | INTERVIEW | NETWORKING_CALL | FAIR | VISA_DEADLINE | PERSONAL | OTHER
  date          DateTime
  endDate       DateTime?
  allDay        Boolean      @default(true)
  location      String?
  notes         String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([date])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id            String       @id @default(cuid())
  name          String
  category      String // CV | COVER_LETTER | TRANSCRIPT | PORTFOLIO | RECOMMENDATION | VISA | OTHER
  version       String?
  filePath      String // relative path under /uploads
  fileSize      Int?
  mimeType      String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tags          Tag[]        @relation("DocumentTags")

  @@index([category])
}

model CoverLetter {
  id                   String      @id @default(cuid())
  applicationId        String      @unique
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId            String?
  company              Company?    @relation(fields: [companyId], references: [id])
  status               String      @default("DRAFT") // DRAFT | TO_REVIEW | READY | SENT
  version              String      @default("v1")
  content              String?
  tone                 String? // PROFESSIONAL | NATURAL | CONCISE | PERSONALIZED
  language             String? // FR | EN
  personalizedElements String?
  documentId           String?
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Interviews / prep
// ---------------------------------------------------------------------------

model Interview {
  id                 String      @id @default(cuid())
  applicationId      String
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?    @relation(fields: [companyId], references: [id])
  roundLabel         String // "Entretien RH", "Entretien manager", ...
  scheduledAt        DateTime?
  durationMinutes    Int?
  format             String? // VIDEO | PHONE | ONSITE
  interviewers       String? // JSON array of names/roles
  notes              String?
  postInterviewNotes String?
  status             String      @default("SCHEDULED") // SCHEDULED | DONE | CANCELLED
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([applicationId])
  @@index([scheduledAt])
}

model InterviewPrep {
  id                 String      @id @default(cuid())
  applicationId      String      @unique
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  whyCompany         String?
  whyRole            String?
  whyCountry         String?
  relevantExperience String?
  questionsToAsk     String?
  weaknessesToPrep   String?
  peopleMet          String? // JSON array
  updatedAt          DateTime    @updatedAt
  createdAt          DateTime    @default(now())

  questions Question[]
}

model Question {
  id              String         @id @default(cuid())
  text            String
  category        String // BEHAVIORAL | TECHNICAL | TO_ASK
  status          String         @default("TO_PREPARE") // TO_PREPARE | IN_PROGRESS | MASTERED
  answerNotes     String?
  interviewPrepId String?
  interviewPrep   InterviewPrep? @relation(fields: [interviewPrepId], references: [id], onDelete: Cascade)
  isBankItem      Boolean        @default(false) // true = reusable global question bank
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Offers & comparison
// ---------------------------------------------------------------------------

model Offer {
  id                String      @id @default(cuid())
  applicationId     String      @unique
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?    @relation(fields: [companyId], references: [id])
  countryId         String?
  country           Country?    @relation(fields: [countryId], references: [id])
  role              String?
  city              String?
  salaryAmount      Float?
  currency          String      @default("EUR")
  bonus             Float?
  housing           Boolean     @default(false)
  visaSupport       Boolean     @default(false)
  durationMonths    Int?
  startDate         DateTime?
  prestige          Int         @default(3) // 1-5
  interest          Int         @default(3)
  learning          Int         @default(3)
  network           Int         @default(3)
  careerPotential   Int         @default(3)
  costOfLivingIndex Int         @default(50) // 0-100, higher = more expensive
  status            String      @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Research database
// ---------------------------------------------------------------------------

model ResearchItem {
  id            String       @id @default(cuid())
  title         String
  url           String?
  category      String // COMPANY | PROGRAM | ARTICLE | RANKING | VISA_ADVICE | CITY | SALARY | PERSON | PLATFORM | OTHER
  summary       String?
  notes         String?
  interestLevel Int          @default(3)
  countryId     String?
  country       Country?     @relation(fields: [countryId], references: [id])
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  addedAt       DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tags          Tag[]        @relation("ResearchTags")
}

// ---------------------------------------------------------------------------
// Notes (freeform, attachable anywhere)
// ---------------------------------------------------------------------------

model Note {
  id            String       @id @default(cuid())
  title         String?
  content       String
  pinned        Boolean      @default(false)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  countryId     String?
  country       Country?     @relation(fields: [countryId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tags          Tag[]        @relation("NoteTags")
}

// ---------------------------------------------------------------------------
// Tags
// ---------------------------------------------------------------------------

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6366f1")

  applications  Application[]  @relation("ApplicationTags")
  companies     Company[]      @relation("CompanyTags")
  contacts      Contact[]      @relation("ContactTags")
  documents     Document[]     @relation("DocumentTags")
  researchItems ResearchItem[] @relation("ResearchTags")
  notes         Note[]         @relation("NoteTags")
}

// ---------------------------------------------------------------------------
// Weekly review
// ---------------------------------------------------------------------------

model WeeklyReview {
  id                  String   @id @default(cuid())
  weekStart           DateTime @unique // Monday 00:00 of that week
  applicationsSent    Int      @default(0)
  companiesResearched Int      @default(0)
  peopleContacted     Int      @default(0)
  responsesReceived   Int      @default(0)
  callsHeld           Int      @default(0)
  interviewsHeld      Int      @default(0)
  refusals            Int      @default(0)
  newOpportunities    Int      @default(0)
  whatWorked          String?
  whatDidntWork       String?
  prioritiesNextWeek  String?
  personalNotes       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Saved views (tracker filters)
// ---------------------------------------------------------------------------

model SavedView {
  id             String   @id @default(cuid())
  name           String
  entity         String   @default("APPLICATION")
  filters        String // JSON
  sort           String? // JSON
  visibleColumns String? // JSON
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Settings (singleton)
// ---------------------------------------------------------------------------

model Setting {
  id                   String    @id @default("singleton")
  userName             String    @default("")
  userEmail            String    @default("")
  searchPeriodStart    DateTime?
  searchPeriodEnd      DateTime?
  preferredCountries   String? // JSON array of country names
  preferredSectors     String? // JSON array
  preferredCurrencies  String? // JSON array, default ["EUR","USD","GBP"]
  sourceOptions        String? // JSON array of opportunity sources
  theme                String    @default("system") // light | dark | system
  followUpRuleDays     Int       @default(7)
  staleOpportunityDays Int       @default(14)
  deadlineWarningDays  Int       @default(3)
  contactSilenceDays   Int       @default(20)
  priorityWeights      String? // JSON: { interest, deadlineProximity, fit, probability, relationship, staleness }
  matchWeights         String? // JSON: { skills, experience, education, languages, location, preferences } — job-match dimension weights
  hasSeenDemoNotice    Boolean   @default(false)

  // AI provider config — the key lives in this local database (never in
  // source code, never logged), so the app never requires an env var edit.
  // A provider abstraction (src/lib/ai) reads this first and falls back to
  // DEEPSEEK_API_KEY in .env for compatibility.
  aiProvider     String  @default("deepseek")
  deepseekApiKey String?

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Candidate profile (singleton) — used to compute the job Match Score
// ---------------------------------------------------------------------------

model Profile {
  id String @id @default("singleton")

  // Personal
  firstName String?
  lastName  String?
  email     String?
  phone     String?

  // Links most job applications ask for directly — kept front and center
  // on the Opportunity detail page's Application section for quick copy.
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?

  // Education
  educationLevel    String? // e.g. Licence, Bachelor, Master, MBA, PhD
  fieldOfStudy      String?
  graduationYear    Int?
  yearsOfExperience Int     @default(0)

  // Experience — JSON array of { title, company, startDate, endDate, description }
  experiences String?

  // Skills & languages
  skills    String? // JSON array of strings
  languages String? // JSON array of { language, level }

  // Preferences / logistics
  workAuthorization String? // free-text personal note — NOT legal advice
  availabilityNote  String?

  // CV — the source of truth the AI is grounded on. cvRawText is the
  // extracted plain text (kept even if the Document is later deleted), so
  // "Improve my CV" / cover letters / the assistant always have it at hand.
  cvDocumentId String?
  cvRawText    String?
  cvParsedAt   DateTime?

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Job posting import — extraction + match/eligibility analysis
// ---------------------------------------------------------------------------

model JobAnalysis {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  sourceUrl        String?
  extractionMethod String // STRUCTURED_DATA | HEURISTIC | MANUAL_PASTE
  rawExtractedText String? // truncated readable text used for extraction, kept for transparency

  responsibilities        String?
  qualifications          String?
  requiredSkills          String? // JSON array of strings
  requiredLanguages       String? // JSON array of strings
  requiredEducationLevel  String?
  requiredExperienceYears Int?
  contractType            String?

  matchScore     Int? // 0-100
  matchBreakdown String? // JSON array of { key, label, weight, score, detail }
  strengths      String? // JSON array of strings
  watchouts      String? // JSON array of strings
  missingSkills  String? // JSON array of strings
  recommendation String?

  eligibilityStatus String? // LIKELY_ELIGIBLE | POSSIBLY_NOT_ELIGIBLE | UNCLEAR
  eligibilityNotes  String? // JSON array of strings

  analyzedAt               DateTime  @default(now())
  profileUpdatedAtSnapshot DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Discover — real, modular job aggregation (Greenhouse/Lever public APIs,
// RSS feeds, and manual CSV/JSON import). Every JobListing row traces back
// to a real JobSource; nothing here is fabricated or simulated.
// ---------------------------------------------------------------------------

model JobSource {
  id   String @id @default(cuid())
  type String // GREENHOUSE | LEVER | RSS | JSON_ENDPOINT | CSV_URL | MANUAL_IMPORT
  name String // display name, e.g. "GitLab (Greenhouse)" or "Personal RSS feed"

  // JSON, shape depends on `type` — e.g. {"boardToken":"gitlab"} for
  // GREENHOUSE, {"companyName":"palantir"} for LEVER, {"feedUrl":"..."} for
  // RSS/JSON_ENDPOINT/CSV_URL. No API keys are needed for the providers
  // shipped today (Greenhouse/Lever's job-board APIs are public); if a
  // future source needs one, store it in Setting the same way as the
  // DeepSeek key — never inline here in plain application code.
  config String

  enabled Boolean @default(true)

  status        String    @default("UNKNOWN") // OK | ERROR | UNKNOWN
  lastSyncedAt  DateTime?
  lastSyncError String?
  jobCount      Int       @default(0) // cached count of active listings from this source

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings JobListing[]

  @@index([type])
}

model JobListing {
  id String @id @default(cuid())

  sourceId    String
  source      JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceJobId String // the id/slug from the source's own system
  sourceUrl   String // canonical link back to the original posting

  title       String
  companyName String
  description String? // plain-text, HTML stripped
  rawText     String? // fuller text kept for extraction/search/matching, truncated

  cityName     String?
  countryName  String?
  remoteType   String? // REMOTE | HYBRID | ONSITE
  sector       String?
  contractType String?
  isInternship Boolean @default(false)

  postedAt       DateTime?
  expiresAt      DateTime?
  startDate      DateTime?
  durationMonths Int?

  salaryAmount   Float?
  salaryCurrency String?

  requiredEducationLevel  String?
  requiredExperienceYears Int?
  requiredSkills          String? // JSON array of strings
  requiredLanguages       String? // JSON array of strings
  visaSponsorship         Boolean? // null = not mentioned/unknown
  tags                    String? // JSON array of strings

  status String @default("ACTIVE") // ACTIVE | EXPIRED | UNKNOWN — never deleted on disappearance, just marked

  // Deduplication: a duplicate points at the primary listing it was merged
  // into; the primary caches how many sources it was found on.
  duplicateOfId     String?
  duplicateOf       JobListing?  @relation("Duplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        JobListing[] @relation("Duplicates")
  foundSourcesCount Int          @default(1)

  // Step 1 — local, deterministic pre-score. Reuses the exact same
  // computeJobMatch/computeEligibility engine as Opportunities (never an
  // AI call), computed at ingest and recomputed whenever the profile
  // changes — this is what makes scoring thousands of listings cheap.
  matchScore                     Int?
  matchBreakdown                 String? // JSON array of ScoreFactor
  strengths                      String? // JSON array of strings
  watchouts                      String? // JSON array of strings
  missingSkills                  String? // JSON array of strings
  recommendation                 String?
  eligibilityStatus              String?
  eligibilityNotes               String? // JSON array of strings
  scoreProfileUpdatedAtSnapshot  DateTime?

  // Step 2 — on-demand AI-enhanced extraction, only run for listings the
  // user actually opens/analyzes (reuses extractJobPostingWithAI).
  aiEnhanced   Boolean   @default(false)
  aiAnalyzedAt DateTime?

  // Set once "Save" turns this into a tracked Opportunity, so re-syncing
  // never creates a second one for the same listing.
  linkedApplicationId String? @unique

  discoveredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceId, sourceJobId])
  @@index([status])
  @@index([isInternship])
  @@index([countryName])
  @@index([cityName])
  @@index([postedAt])
  @@index([matchScore])
  @@index([duplicateOfId])
  @@index([companyName])
}

model SavedSearch {
  id      String  @id @default(cuid())
  name    String
  query   String? // free-text keywords
  filters String // JSON: {countries, cities, industries, remoteType, minMatch, visaFriendly, sourceIds, deadlineWithinDays, ...}
  sort    String  @default("match")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobWatch {
  id          String  @id @default(cuid())
  keyword     String?
  countryName String?
  cityName    String?
  sector      String?

  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
}
