// Internship Search Tracker — Prisma schema
// SQLite does not support native enums, so status-like fields are Strings
// validated in the application layer (see src/lib/constants.ts) — this also
// lets the user define custom statuses without a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------------

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities       City[]
  companies    Company[]
  applications Application[]

  @@index([name])
}

model City {
  id        String   @id @default(cuid())
  name      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  applications Application[]

  @@unique([name, countryId])
}

// ---------------------------------------------------------------------------
// Companies
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])
  sector    String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  documents    Document[]
  coverLetters CoverLetter[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// Pipeline / custom statuses
// ---------------------------------------------------------------------------

model PipelineStage {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  isSystem  Boolean  @default(false) // seeded default stage, not deletable from UI
  kind      String   @default("APPLICATION") // APPLICATION | NETWORKING
  createdAt DateTime @default(now())

  applications Application[]
}

// ---------------------------------------------------------------------------
// Applications (the core tracker)
// ---------------------------------------------------------------------------

model Application {
  id        String  @id @default(cuid())
  title     String // intitulé du stage
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])

  remotePossible Boolean @default(false)
  sector         String?

  jobUrl String?
  source String? // LinkedIn, Site entreprise, Candidature spontanée, Networking, ...

  discoveredAt       DateTime?
  appliedAt          DateTime?
  deadline           DateTime?
  potentialStartDate DateTime?
  durationMonths     Int?

  salaryAmount   Float?
  salaryCurrency String? @default("EUR")

  statusId String
  status   PipelineStage @relation(fields: [statusId], references: [id])

  nextAction        String?
  nextActionDate    DateTime?
  followUpCount     Int       @default(0)
  lastInteractionAt DateTime?

  notes              String?
  interviewPrepNotes String? // AI-generated "Prepare interview" output, rattaché directement à l'opportunité
  interviewChecklist String? // JSON array of { id, label, done } — user-managed interview prep checklist
  applicationType    String   @default("ADVERTISED") // ADVERTISED | SPONTANEOUS
  outreachChannel    String? // EMAIL | LINKEDIN | WEBSITE | CONTACT | OTHER
  recipientName      String?
  recipientValue     String? // email address, profile URL or application URL
  targetRole         String?
  companyResearch    String?
  messageDraft       String?
  followUpAt         DateTime?
  aiChatHistory      String? // JSON array of opportunity-scoped chat messages
  deletedAt          DateTime? // soft delete — hidden everywhere, restorable from the trash
  isDemo             Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents   Document[]
  coverLetter CoverLetter?
  jobAnalysis JobAnalysis?
  activities  Activity[]

  @@index([companyId])
  @@index([statusId])
  @@index([deadline])
  @@index([nextActionDate])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Activity — automatic, append-only timeline per application
// ---------------------------------------------------------------------------

model Activity {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // CREATED | STATUS_CHANGE | APPLIED | FOLLOW_UP | NOTE | DOCUMENT | INTERVIEW_PREP | COVER_LETTER
  summary       String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Leads — a lightweight capture inbox for URLs/companies to triage later
// ---------------------------------------------------------------------------

model Lead {
  id        String   @id @default(cuid())
  url       String?
  company   String?
  role      String?
  note      String?
  status    String   @default("NEW") // NEW | CONVERTED | DISCARDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id            String       @id @default(cuid())
  name          String
  category      String // CV | COVER_LETTER | TRANSCRIPT | PORTFOLIO | RECOMMENDATION | VISA | OTHER
  version       String?
  filePath      String // relative path under /uploads
  fileSize      Int?
  mimeType      String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category])
}

model CoverLetter {
  id                   String      @id @default(cuid())
  applicationId        String      @unique
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId            String?
  company              Company?    @relation(fields: [companyId], references: [id])
  status               String      @default("DRAFT") // DRAFT | TO_REVIEW | READY | SENT
  version              String      @default("v1")
  content              String?
  tone                 String? // PROFESSIONAL | NATURAL | CONCISE | PERSONALIZED
  language             String? // FR | EN
  personalizedElements String?
  documentId           String?
  notes                String?
  chatHistory          String? // JSON array of user/assistant refinement messages
  revisionHistory      String? // JSON array of previous generated versions
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Settings (singleton)
// ---------------------------------------------------------------------------

model Setting {
  id                   String    @id @default("singleton")
  userName             String    @default("")
  userEmail            String    @default("")
  searchPeriodStart    DateTime?
  searchPeriodEnd      DateTime?
  preferredCountries   String? // JSON array of country names
  preferredSectors     String? // JSON array
  preferredCurrencies  String? // JSON array, default ["EUR","USD","GBP"]
  sourceOptions        String? // JSON array of opportunity sources
  theme                String    @default("system") // light | dark | system
  followUpRuleDays     Int       @default(7)
  staleOpportunityDays Int       @default(14)
  deadlineWarningDays  Int       @default(3)

  // AI provider config — the key lives in this local database (never in
  // source code, never logged), so the app never requires an env var edit.
  // A provider abstraction (src/lib/ai) reads this first and falls back to
  // DEEPSEEK_API_KEY in .env for compatibility.
  aiProvider     String  @default("deepseek")
  deepseekApiKey String?

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Candidate profile (singleton) — used to compute the job Match Score
// ---------------------------------------------------------------------------

model Profile {
  id String @id @default("singleton")

  // Personal
  firstName String?
  lastName  String?
  email     String?
  phone     String?
  location  String?
  headline  String?
  summary   String?

  // Links most job applications ask for directly — kept front and center
  // on the Opportunity detail page's Application section for quick copy.
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?

  // Education
  educationLevel    String? // e.g. Licence, Bachelor, Master, MBA, PhD
  fieldOfStudy      String?
  graduationYear    Int?
  yearsOfExperience Int     @default(0)

  // Rich candidate history used to ground every AI workflow.
  experiences String?
  educationHistory String? // JSON array of { institution, degree, startDate, endDate, description }
  projects String? // JSON array of { name, description, technologies, url, repositoryUrl }

  // Skills & languages
  skills    String? // JSON array of strings
  languages String? // JSON array of { language, level }

  // Preferences / logistics
  workAuthorization String? // free-text personal note — NOT legal advice
  availabilityNote  String?
  availabilityStart DateTime?
  availabilityEnd   DateTime?
  minDurationWeeks  Int?
  maxDurationWeeks  Int?

  // CV — the source of truth the AI is grounded on. cvRawText is the
  // extracted plain text (kept even if the Document is later deleted), so
  // "Improve my CV" / cover letters / interview prep always have it at hand.
  cvDocumentId String?
  cvRawText    String?
  cvParsedAt   DateTime?

  // Reference cover letter — the candidate's own past letter, used as the
  // voice/structure anchor when drafting a new one. Extracted plain text
  // (kept even if the Document is deleted), stored locally like the CV.
  coverLetterReference           String?
  coverLetterReferenceDocumentId String?

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Job posting import — extraction + match/eligibility analysis
// ---------------------------------------------------------------------------

model JobAnalysis {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  sourceUrl        String?
  extractionMethod String // STRUCTURED_DATA | HEURISTIC | MANUAL_PASTE
  rawExtractedText String? // truncated readable text used for extraction, kept for transparency

  responsibilities        String?
  qualifications          String?
  requiredSkills          String? // JSON array of strings
  requiredLanguages       String? // JSON array of strings
  requiredEducationLevel  String?
  requiredExperienceYears Int?
  requiredStartDate       DateTime?
  requiredEndDate         DateTime?
  requiredDurationWeeks   Int?
  contractType            String?

  matchScore     Int? // 0-100
  matchBreakdown String? // JSON array of { key, label, weight, score, detail }
  strengths      String? // JSON array of strings
  watchouts      String? // JSON array of strings
  missingSkills  String? // JSON array of strings
  recommendation String?

  eligibilityStatus String? // LIKELY_ELIGIBLE | POSSIBLY_NOT_ELIGIBLE | UNCLEAR
  eligibilityNotes  String? // JSON array of strings

  analyzedAt               DateTime  @default(now())
  profileUpdatedAtSnapshot DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
