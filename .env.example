DATABASE_URL="file:./dev.db"

# Docker/Traefik only. Generate with:
#   htpasswd -nbB candidate 'your-password'
# Keep the generated value in the VPS .env file, never in Git.
# BASIC_AUTH_USERS='candidate:$2y$...'

# Optional. Powers AI-assisted job-posting extraction (fills gaps the rule-
# based parser can't confidently detect) and cover-letter drafts in the
# "Prepare application" tab. The app works fully without it — extraction
# falls back to schema.org structured data + heuristics, and cover letters
# fall back to a template. Get a key at https://platform.deepseek.com
# DEEPSEEK_API_KEY=""
