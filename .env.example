DATABASE_URL="file:./dev.db"

# Docker/Traefik only. Generate with:
#   htpasswd -nbB candidate 'your-password'
# Keep the generated value in the VPS .env file, never in Git.
# BASIC_AUTH_USERS='candidate:$2y$...'

# ---------------------------------------------------------------------------
# AI (optional). Powers job-posting extraction, cover letters, CV analysis,
# interview prep and the opportunity coach. The app works fully without it.
# Get a key at https://platform.deepseek.com
# DEEPSEEK_API_KEY=""

# ---------------------------------------------------------------------------
# Discovery / Recherche (all optional). A source is enabled simply by the
# presence of its key here — there is no per-source settings screen, and the
# search queries are derived from your profile automatically.

# JSearch — LinkedIn, Indeed, Glassdoor, ZipRecruiter… (via Google for Jobs).
# Free Basic plan: 200 requests/month. https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY=""

# Adzuna — aggregated job search, 15+ countries. Free tier ~250 requests/day.
# https://developer.adzuna.com
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""

# Serper — general web search (reaches sites without an API, e.g. JobTeaser).
# Free trial 2,500 queries. https://serper.dev
# SERPER_API_KEY=""

# Note: companies published on Greenhouse / Lever / Ashby are searched through
# their public job-board APIs with no key at all (see src/lib/search/ats-companies.ts).
